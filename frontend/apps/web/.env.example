# ResearchLens API (apps/api). Run the backend with `npm run dev:local`.
VITE_API_URL=http://localhost:5000/api

# Dev only — Mock Service Worker handlers in src/mocks/.
#   false    call the real backend for everything
#   planned  mock only the Phase 4–7 endpoints (documents + research); auth/projects hit the backend
#   true     mock everything; a demo account is seeded (see src/mocks/handlers.ts → seed())
VITE_USE_MOCKS=false
