# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# For local development without Atlas, run `npm run dev:local` instead.
MONGODB_URI=

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s), comma-separated
CLIENT_URL=http://localhost:5173

# ---- AI provider (backend only; never put these in the frontend) ----------
# gemini | groq | openai   (openai = any OpenAI-compatible API: OpenRouter,
# LM Studio, Ollama)
AI_PROVIDER=gemini

# Google Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is overloaded, out of quota or retired.
# Each model has its own free-tier quota.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash

# Groq: free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Generic OpenAI-compatible provider (used when AI_PROVIDER=openai), e.g.
#   LM Studio: AI_BASE_URL=http://localhost:1234/v1  AI_MODEL=qwen2.5-7b-instruct
#   Ollama:    AI_BASE_URL=http://localhost:11434/v1 AI_MODEL=qwen2.5:7b
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
